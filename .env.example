NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://clear_blue_dispatch:<password>@<host>:5432/clear_blue_dispatch

AUTH_SECRET=<auth_secret>

SMTP_HOST=<smtp.example.com>
SMTP_PORT=<port>
SMTP_SECURE=<true/false>
SMTP_USERNAME=<your-email@example.com>
SMTP_PASSWORD=<your-password>
SMTP_FROM=<your-email@example.com>

VDA_CERTIFICATION_NUMBER=<vda_certification_number>
NMI_CERTIFICATION_NUMBER=<nmi_certification_number>

DIRECTOR_NAME=<director_name>
DIRECTOR_PHONE=<director_phone>
DIRECTOR_EMAIL=<director_email>
OFFICE_PHONE=<office_phone>
OFFICE_EMAIL=<office_email>
ABN_NUMBER=<abn>
WEBSITE_URL=<website_url>

ENABLE_EMAIL_NOTIFICATIONS=<true/false>