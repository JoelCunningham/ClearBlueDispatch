enum UserRole {
  DRIVER
  MANAGER
}

model User {
  id             Int      @id @default(autoincrement())

  email          String   @unique
  name           String
  role           UserRole
  passwordHash   String

  deleted        Boolean  @default(false)
  firstLogin     Boolean  @default(true)
  sessionVersion Int      @default(0)

  routes         Route[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model Route {
  id             Int        @id @default(autoincrement())

  assignedUser   User       @relation(fields:[assignedUserId], references:[id])
  assignedUserId Int
  date           DateTime

  deliveries     Delivery[]

  @@unique([assignedUserId, date])
}

model Delivery {
  id          Int      @id @default(autoincrement())

  route       Route    @relation(fields:[routeId], references:[id])
  routeId     Int

  location    Location @relation(fields:[locationId], references:[id], onDelete: Restrict)
  locationId  Int

  contact     Contact? @relation(fields:[contactId], references:[id], onDelete: Restrict)
  contactId   Int?

  docket      Docket?

  position    Int
  notes       String
  tankDetails String
  deleted     Boolean  @default(false)
}

model Docket {
  id           Int      @id @default(autoincrement())

  volume       Int
  batchNumber  String
  comments     String?
  repName      String
  repSignature Bytes
  deleted      Boolean  @default(false)

  delivery     Delivery @relation(fields:[deliveryId], references:[id])
  deliveryId   Int      @unique
}

model Location {
  id         Int        @id @default(autoincrement())
  customer   Customer   @relation(fields:[customerId], references:[id])
  customerId Int

  address    String
  deleted    Boolean    @default(false)

  deliveries Delivery[]
}

model Customer {
  id            Int            @id @default(autoincrement())

  name          String
  rate          Float

  locations     Location[]
  contacts      Contact[]
  invoiceEmails InvoiceEmail[]
  deleted       Boolean        @default(false)
}

model Contact {
  id          Int        @id @default(autoincrement())

  customer    Customer   @relation(fields:[customerId], references:[id])
  customerId  Int

  name        String
  phoneNumber String
  deleted     Boolean    @default(false)

  deliveries  Delivery[]
}

model InvoiceEmail {
  id           Int      @id @default(autoincrement())

  customer     Customer @relation(fields:[customerId], references:[id])
  customerId   Int

  emailAddress String
  deleted      Boolean  @default(false)
}
