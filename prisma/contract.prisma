// use prisma-8

enum UserRole {
  DRIVER
  MANAGER
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      UserRole
  routes    Route[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Route {
  id           Int        @id @default(autoincrement())
  assignedUser User       @relation(fields: [assignedUserId], references: [id])
  assignedUserId Int
  date         DateString
  deliveries   Delivery[]

  @@unique([assignedUserId, date])
}

model Delivery {
  id      Int   @id @default(autoincrement())
  route   Route @relation(fields: [routeId], references: [id])
  routeId Int
  tankDetails String
  notes String
}